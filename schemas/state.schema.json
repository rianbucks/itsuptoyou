{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayState",
  "type": "object",
  "required": [
    "seed", "rngState", "narrationRngState", "figure", "year", "age", "alive", "stats", "traits", "flags",
    "focus", "focusHistory", "growthHistory", "history", "eventHistory",
    "survivalHistory", "narrationHistory", "deathCause", "pending"
  ],
  "properties": {
    "seed": { "type": "integer", "minimum": 0 },
    "rngState": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "narrationRngState": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "figure": { "type": "string" },
    "year": { "type": "integer" },
    "age": { "type": "integer", "minimum": 0 },
    "alive": { "type": "boolean" },
    "stats": {
      "type": "object",
      "propertyNames": { "$ref": "stat-id.schema.json" },
      "required": ["leadership", "intelligence", "diplomacy", "charisma", "creativity", "vitality"],
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "traits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "flags": {
      "type": "object",
      "required": ["deviated", "outlived", "extraYears"],
      "properties": {
        "deviated": { "type": "boolean" },
        "outlived": { "type": "boolean" },
        "extraYears": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": { "type": ["boolean", "number", "string"] }
    },
    "focus": { "anyOf": [{ "$ref": "stat-id.schema.json" }, { "type": "null" }] },
    "focusHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromYear", "stat"],
        "properties": {
          "fromYear": { "type": "integer" },
          "stat": { "$ref": "stat-id.schema.json" }
        }
      }
    },
    "growthHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "choice", "year"],
        "properties": {
          "event": { "type": "string" },
          "choice": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "choice", "result", "probability", "year"],
        "properties": {
          "node": { "type": "string" },
          "choice": { "type": "string" },
          "result": { "enum": ["success", "failure"] },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "year": { "type": "integer" }
        }
      }
    },
    "eventHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "choice", "year", "age"],
        "properties": {
          "event": { "type": "string" },
          "choice": { "type": "string" },
          "year": { "type": "integer" },
          "age": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "survivalHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "age", "probability", "survived"],
        "properties": {
          "year": { "type": "integer" },
          "age": { "type": "integer", "minimum": 0 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "survived": { "type": "boolean" }
        }
      }
    },
    "narrationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "kind", "id"],
        "properties": {
          "year": { "type": "integer" },
          "kind": { "enum": ["era", "chronicle", "life"] },
          "id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "deathCause": { "enum": ["node", "survival", "naturalDeath", "maxAgeDeath", null] },
    "pending": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "year"],
          "properties": {
            "kind": { "enum": ["focus", "growth", "node", "commonEvent"] },
            "id": { "type": "string" },
            "year": { "type": "integer" }
          }
        }
      ]
    }
  }
}
