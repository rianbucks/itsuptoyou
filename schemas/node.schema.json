{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node",
  "type": "object",
  "required": ["id", "figure", "kind", "year", "title", "situation", "choices"],
  "properties": {
    "id": { "type": "string" },
    "figure": { "type": "string" },
    "kind": { "enum": ["historical", "alternate"] },
    "year": { "type": "integer" },
    "title": { "type": "string" },
    "requires": {
      "type": "object",
      "properties": {
        "flags": { "type": "object", "additionalProperties": { "type": ["boolean", "number", "string"] } },
        "alive": { "type": "boolean" }
      }
    },
    "replaces": { "type": "string" },
    "foreshadow": { "type": "string" },
    "situation": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "disputed": { "$ref": "disputed.schema.json" },
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "historical", "check", "success", "failure"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "historical": { "type": "boolean" },
          "harm": { "$ref": "harm.schema.json" },
          "check": {
            "type": "object",
            "required": ["stats", "difficulty"],
            "properties": {
              "stats": { "type": "object", "propertyNames": { "$ref": "stat-id.schema.json" }, "additionalProperties": { "type": "number" } },
              "traitBonus": { "type": "object", "additionalProperties": { "type": "number" } },
              "difficulty": { "type": "number" }
            }
          },
          "success": { "$ref": "#/$defs/outcome" },
          "failure": { "$ref": "#/$defs/outcome" }
        },
        "if": { "required": ["harm"], "properties": { "historical": { "const": true } } },
        "then": { "properties": { "harm": { "required": ["sources"] } } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "historical" } } },
      "then": {
        "required": ["sources"],
        "properties": {
          "choices": {
            "contains": { "required": ["historical"], "properties": { "historical": { "const": true } } },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "alternate" } } },
      "then": {
        "properties": {
          "choices": { "items": { "properties": { "historical": { "const": false } } } }
        }
      }
    }
  ],
  "$defs": {
    "outcome": {
      "type": "object",
      "required": ["fragment"],
      "properties": {
        "fragment": { "type": "string" },
        "setFlags": { "type": "object", "propertyNames": { "not": { "$ref": "reserved-flags.schema.json" } }, "additionalProperties": { "type": ["boolean", "number", "string"] } },
        "statChanges": { "type": "object", "propertyNames": { "$ref": "stat-id.schema.json" }, "additionalProperties": { "type": "number" } },
        "addTraits": { "type": "array", "items": { "type": "string" } },
        "removeTraits": { "type": "array", "items": { "type": "string" } },
        "death": { "type": "boolean" }
      }
    }
  }
}
