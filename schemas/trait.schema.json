{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trait",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "statModifiers": {
      "type": "object",
      "propertyNames": { "$ref": "stat-id.schema.json" },
      "additionalProperties": { "type": "number" }
    }
  }
}
